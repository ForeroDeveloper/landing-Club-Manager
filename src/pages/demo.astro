---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/landing/Navbar.astro';
import Footer from '../components/landing/Footer.astro';
---

<Layout 
	title="Agenda tu Demostración | ClubSport Manager"
	description="Descubre cómo ClubSport Manager puede transformar la gestión de tu academia deportiva en solo 20 minutos."
>
	<Navbar />
	<main class="min-h-screen bg-background pt-24 pb-16">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-start">
        
        <!-- Columna de Texto -->
        <div class="lg:col-span-2 lg:sticky lg:top-32 pt-8">
          <div class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-sm font-medium text-primary mb-6">
            Llamada sin compromiso
          </div>
          <h1 class="text-4xl md:text-5xl font-bold mb-6 tracking-tight">Agenda tu demo gratuita</h1>
          <p class="text-lg text-muted-foreground mb-8 leading-relaxed">
            Elige el horario que mejor te funcione. En solo 20 minutos te mostraremos exactamente cómo nuestra plataforma puede eliminar tu trabajo manual y aumentar la recaudación de tu club.
          </p>
          
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="flex-shrink-0 grid h-12 w-12 place-items-center rounded-full bg-primary/10 text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
              <div class="mt-2">
                <h3 class="font-bold text-lg">Evaluación personalizada</h3>
                <p class="text-muted-foreground text-sm">Analizamos los retos actuales de tu academia deportiva.</p>
              </div>
            </div>
            
            <div class="flex gap-4">
              <div class="flex-shrink-0 grid h-12 w-12 place-items-center rounded-full bg-primary/10 text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="m9 16 2 2 4-4"/></svg>
              </div>
              <div>
                <h3 class="font-bold text-lg">Recorrido por la plataforma</h3>
                <p class="text-muted-foreground text-sm">Te mostramos cómo automatizar cobros y asistencia.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Columna Interactiva (Formulario -> Calendly) -->
        <div class="lg:col-span-3 w-full">
          <div class="bg-card border border-border rounded-3xl shadow-glow overflow-hidden relative w-full min-h-[700px] flex flex-col">
            
            <!-- Paso 1: Formulario Rápido -->
            <div id="lead-form-container" class="w-full flex-1 flex flex-col justify-center p-6 md:p-12 transition-all duration-500 z-20">
              <div class="max-w-md mx-auto w-full bg-card border border-border rounded-[2rem] p-8 md:p-10 shadow-glow relative overflow-hidden">
                
                <!-- Decoración sutil de fondo -->
                <div class="absolute -top-10 -right-10 w-32 h-32 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

                <div class="relative z-10">
                  <div class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary mb-6">
                    +500 clubes ya están dentro
                  </div>

                  <h2 class="text-3xl font-bold mb-3 tracking-tight">Comencemos</h2>
                  <p class="text-muted-foreground mb-8 text-sm leading-relaxed">Déjanos tus datos para prepararte un entorno de prueba y apartar tu espacio en la agenda.</p>
                  
                  <form id="lead-form" class="space-y-5">
                    
                    <div class="space-y-2">
                      <label for="nombre" class="text-sm font-semibold text-foreground">Tu Nombre Completo *</label>
                      <input type="text" id="nombre" name="nombre" required class="w-full h-12 rounded-xl border border-border bg-background px-4 focus:ring-2 focus:ring-primary focus:border-primary transition-shadow outline-none placeholder:text-muted-foreground" placeholder="Ej: Carlos Ramírez">
                    </div>
                    
                    <div class="space-y-2">
                      <label for="club" class="text-sm font-semibold text-foreground">Nombre del Club o Academia *</label>
                      <input type="text" id="club" name="club" required class="w-full h-12 rounded-xl border border-border bg-background px-4 focus:ring-2 focus:ring-primary focus:border-primary transition-shadow outline-none placeholder:text-muted-foreground" placeholder="Ej: Academia FC">
                    </div>

                    <div class="space-y-2">
                      <label for="whatsapp" class="text-sm font-semibold text-foreground">Número de WhatsApp *</label>
                      <div class="flex relative shadow-sm rounded-xl">
                        <div class="flex-shrink-0 inline-flex items-center px-4 rounded-l-xl border border-r-0 border-border bg-muted/30">
                          <span class="text-xl mr-2 leading-none">🇨🇴</span>
                          <span class="text-sm font-bold text-muted-foreground">+57</span>
                        </div>
                        <input type="tel" id="whatsapp" name="whatsapp" required pattern="3[0-9]{9}" title="Ingresa 10 dígitos (ej: 3001234567)" maxlength="10" minlength="10" class="w-full h-12 rounded-r-xl border border-border bg-background px-4 focus:ring-2 focus:ring-primary focus:border-primary transition-shadow outline-none placeholder:text-muted-foreground" placeholder="3001234567" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                      </div>
                      <p class="text-[10px] text-muted-foreground mt-1">Ingresa únicamente los 10 dígitos de tu celular.</p>
                    </div>

                    <div class="pt-6">
                      <button type="submit" id="submit-btn" class="inline-flex items-center justify-center rounded-xl bg-primary text-primary-foreground text-lg font-bold transition-transform hover:scale-[1.02] shadow-lg h-16 px-8 w-full disabled:opacity-70 disabled:hover:scale-100">
                        <span id="btn-text">Ver Horarios Disponibles</span>
                        <svg id="btn-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        <svg id="btn-spinner" class="animate-spin ml-2 hidden h-6 w-6 text-primary-foreground" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                      </button>
                    </div>
                    
                    <div class="flex items-center justify-center gap-2 mt-4 text-xs font-medium text-muted-foreground">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                      Tus datos están 100% seguros
                    </div>
                  </form>
                </div>
              </div>
            </div>

            <!-- Paso 2: Contenedor Calendly (Oculto inicialmente) -->
            <div id="calendly-wrapper" class="hidden w-full flex-1 relative min-h-[700px]">
              
              <!-- Spinner de carga de Calendly -->
              <div id="calendly-spinner" class="absolute inset-0 flex flex-col items-center justify-center bg-card z-0 transition-opacity duration-500">
                <div class="w-12 h-12 border-4 border-primary/20 border-t-primary rounded-full animate-spin mb-4"></div>
                <p class="text-sm text-muted-foreground font-medium animate-pulse">Preparando calendario...</p>
              </div>

              <!-- Widget real de Calendly -->
              <div id="calendly-container" class="relative z-10 w-full h-full"></div>
            </div>
            
          </div>
        </div>

      </div>
		</div>
	</main>
	<Footer />
</Layout>

<script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('lead-form');
    const formContainer = document.getElementById('lead-form-container');
    const calendlyWrapper = document.getElementById('calendly-wrapper');
    const calendlyContainer = document.getElementById('calendly-container');
    const calendlySpinner = document.getElementById('calendly-spinner');
    
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');
    const btnIcon = document.getElementById('btn-icon');
    const btnSpinner = document.getElementById('btn-spinner');

    // Escuchar el evento de Calendly para saber cuándo ocultar el spinner
    window.addEventListener('message', function(e) {
      if (e.data.event && e.data.event.indexOf('calendly.event_type_viewed') === 0 || e.data.event === 'calendly.page_size') {
        if (calendlySpinner) {
          calendlySpinner.classList.add('opacity-0');
          setTimeout(() => calendlySpinner.classList.add('hidden'), 500);
        }
      }
    });

    if (form && formContainer && calendlyWrapper && calendlyContainer && submitBtn) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Estado de carga del botón
        submitBtn.setAttribute('disabled', 'true');
        btnText.textContent = 'Guardando...';
        btnIcon.classList.add('hidden');
        btnSpinner.classList.remove('hidden');
        
        const formData = new FormData(form as HTMLFormElement);
        // Formatear el número para incluir el código de país en la base de datos
        const whatsappNumber = formData.get('whatsapp');
        const formattedWhatsapp = '+57' + whatsappNumber;

        const data = {
          nombre: formData.get('nombre'),
          club: formData.get('club'),
          whatsapp: formattedWhatsapp,
          fecha_registro: new Date().toISOString(),
          origen: 'landing_page'
        };

        try {
          // 1. Enviar datos a Firebase
          const response = await fetch('https://club-sport-manager-default-rtdb.firebaseio.com/leads.json', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(data)
          });

          if (!response.ok) throw new Error('Error al guardar en Firebase');

          // 2. Ocultar formulario
          formContainer.classList.add('hidden');
          
          // 3. Mostrar contenedor de Calendly
          calendlyWrapper.classList.remove('hidden');

          // 4. Inicializar Calendly programáticamente
          // @ts-ignore
          if (window.Calendly) {
            // @ts-ignore
            window.Calendly.initInlineWidget({
              url: 'https://calendly.com/forerodeveloper/30min?hide_event_type_details=1&hide_gdpr_banner=1&primary_color=52a23c',
              parentElement: calendlyContainer,
              prefill: {},
              utm: {}
            });
          } else {
            // Si el script de Calendly falló en cargar, fallback
            calendlyContainer.innerHTML = '<p class="p-8 text-center">No se pudo cargar el calendario. Por favor recarga la página.</p>';
          }

        } catch (error) {
          console.error("Error guardando el lead:", error);
          alert("Hubo un error al procesar tus datos. Por favor intenta nuevamente.");
          
          // Restaurar botón
          submitBtn.removeAttribute('disabled');
          btnText.textContent = 'Ver Horarios Disponibles';
          btnIcon.classList.remove('hidden');
          btnSpinner.classList.add('hidden');
        }
      });
    }
  });
</script>

<style is:global>
  /* Forzar que Calendly ocupe todo el espacio disponible sin cortarse */
  #calendly-container .calendly-inline-widget,
  #calendly-container iframe {
    width: 100% !important;
    height: 100% !important;
    min-height: 700px !important;
  }
</style>
