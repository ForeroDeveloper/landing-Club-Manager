---
const screens = [
  { img: "/s1.jpg", title: "Control Total", desc: "Gestiona tu club desde tu bolsillo" },
  { img: "/s2.jpg", title: "Asistencia Rápida", desc: "Toma lista en segundos en la cancha" },
  { img: "/s3.jpg", title: "Pagos y Recaudos", desc: "Supervisa los ingresos al instante" },
  { img: "/s4.jpg", title: "Comunicación", desc: "Notifica a los padres y jugadores" }
];
---

<section id="app-showcase" class="mx-auto max-w-7xl px-4 py-24 sm:px-6">
  <div class="mx-auto max-w-3xl text-center mb-16">
    <div class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-sm font-medium text-primary mb-6">
      App Móvil Incluida
    </div>
    <h2 class="text-3xl font-bold tracking-tight sm:text-5xl mb-6">
      Tu academia en la palma de tu mano
    </h2>
    <p class="text-lg text-muted-foreground">
      Nuestra aplicación móvil le da a tus entrenadores y administradores el poder de controlar todo directamente desde la cancha. Cero computadoras requeridas.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
    {screens.map((screen) => (
      <div class="flex flex-col items-center group">
        <!-- Phone Frame Mockup -->
        <div class="relative rounded-[2.5rem] border-8 border-card bg-card overflow-hidden shadow-2xl ring-1 ring-border/50 w-full max-w-[260px] aspect-[9/19] mb-6 transition-transform duration-500 group-hover:-translate-y-3">
           <img src={screen.img} class="w-full h-full object-cover object-top" alt={screen.title} />
        </div>
        
        <h3 class="font-bold text-lg mb-1">{screen.title}</h3>
        <p class="text-sm text-muted-foreground text-center px-4">{screen.desc}</p>
      </div>
    ))}
  </div>
</section>
