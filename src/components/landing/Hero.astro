<section class="relative overflow-hidden bg-gradient-soft">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-40 left-1/2 h-[600px] w-[900px] -translate-x-1/2 rounded-full bg-primary/10 blur-[120px]" />
  </div>

  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:py-28">
    <div class="flex flex-col justify-center">
      <div class="inline-flex w-fit items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3v1"/><path d="M12 20v1"/><path d="M3 12h1"/><path d="M20 12h1"/><path d="m4.93 4.93.7.7"/><path d="m18.36 18.36.7.7"/><path d="m19.07 4.93-.7.7"/><path d="m5.64 18.36-.7.7"/><path d="M8 12h8"/><path d="M12 8v8"/>
        </svg>
        Nueva temporada · 0% setup
      </div>

      <h1 class="mt-5 text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
        El fin del caos en tu club o academia de <span id="sport-text" class="text-gradient">fútbol</span>
      </h1>

      <p class="mt-5 max-w-xl text-lg text-muted-foreground">
        Aumenta tu recaudación, controla asistencias desde el celular y automatiza las notificaciones a los padres. Deja de administrar en Excel y WhatsApp.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/demo" class="inline-flex items-center justify-center rounded-full bg-primary text-primary-foreground text-sm font-bold transition-transform hover:scale-105 hover:bg-primary/90 shadow-glow h-12 px-8 py-3">
          Agenda una demostración gratuita
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
        <a href="#solucion" class="inline-flex items-center justify-center rounded-full text-sm font-medium transition-colors hover:bg-accent/50 hover:text-accent-foreground h-12 px-6 py-3 border border-border/50 backdrop-blur-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
          Ver cómo funciona
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-muted-foreground">
        <span class="inline-flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
          </svg>
          Datos cifrados
        </span>
        <span class="inline-flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          +320 clubes activos
        </span>
        <span class="inline-flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
          </svg>
          98% de cobro mensual
        </span>
      </div>
    </div>

    <div class="relative">
      <div class="relative rounded-[2rem] border-8 border-card bg-card overflow-hidden shadow-2xl transition-transform duration-700 hover:scale-[1.02] ring-1 ring-border/50">
        <img src="/ss2.png" alt="Dashboard de ClubSport Manager" class="w-full h-auto object-cover rounded-xl" />
      </div>

      <!-- Floating cards -->
      <div class="absolute -bottom-6 -left-4 hidden w-64 rounded-2xl border border-border bg-card p-4 shadow-card sm:block">
        <p class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Asistencia hoy</p>
        <div class="mt-2 flex items-end justify-between">
          <p class="text-2xl font-bold">94%</p>
          <div class="flex -space-x-2">
            <div class="h-7 w-7 rounded-full border-2 border-card" style="background: #52a23c" />
            <div class="h-7 w-7 rounded-full border-2 border-card" style="background: #A3D977" />
            <div class="h-7 w-7 rounded-full border-2 border-card" style="background: #1B7A4B" />
          </div>
        </div>
      </div>

      <div class="absolute -top-6 -right-4 hidden rounded-2xl border border-border bg-card p-3 shadow-card sm:flex sm:items-center sm:gap-3">
        <div class="grid h-9 w-9 place-items-center rounded-xl bg-success/15 text-success">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold">+18 inscritos</p>
          <p class="text-[11px] text-muted-foreground">Esta semana</p>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ sports: ['fútbol', 'básquetbol', 'vóley', 'natación', 'tenis', 'atletismo'] }}>
    const sportText = document.getElementById('sport-text');
    let currentIndex = 0;

    setInterval(() => {
      // Fade out
      sportText.style.transition = 'opacity 0.3s ease-in-out';
      sportText.style.opacity = '0';

      setTimeout(() => {
        // Change text
        currentIndex = (currentIndex + 1) % sports.length;
        sportText.textContent = sports[currentIndex];

        // Fade in
        sportText.style.opacity = '1';
      }, 300);
    }, 2500);
  </script>
</section>
