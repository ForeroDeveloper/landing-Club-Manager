---
const stats = [
  { v: "150,000+", l: "Notificaciones enviadas", d: "Avisos de pagos y citaciones que llegaron directamente a los padres." },
  { v: "$2M+", l: "Pagos registrados", d: "Procesados de forma automática y conciliados sin intervención manual." },
  { v: "12,000+", l: "Jugadores administrados", d: "Perfiles centralizados, asistencia y control en la palma de la mano." },
  { v: "80%", l: "Menos tiempo perdido", d: "En tareas administrativas, permitiendo a los clubes crecer más rápido." },
];
---

<section id="stats" class="border-y border-border bg-card">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-16 sm:px-6 sm:grid-cols-2 lg:grid-cols-4">
    {stats.map((s) => (
      <div class="text-center">
        <p class="text-4xl font-bold tracking-tight text-gradient">{s.v}</p>
        <p class="mt-2 text-sm font-semibold">{s.l}</p>
        <p class="mt-1 text-sm text-muted-foreground leading-snug">{s.d}</p>
      </div>
    ))}
  </div>
</section>
