---
const steps = [
  { n: "01", t: "Crea tu club", d: "Configura tus sedes, categorías y entrenadores en minutos. Nuestro equipo de soporte te acompaña en todo el proceso de adopción." },
  { n: "02", t: "Invita jugadores", d: "Envía un enlace único para que los padres descarguen la app, completen los datos y suban los documentos sin que tú muevas un dedo." },
  { n: "03", t: "Administra todo desde un solo lugar", d: "Recauda pagos automáticamente, lleva asistencia en tiempo real y comunícate con toda la comunidad sin usar Excel ni WhatsApp." },
];
---

<section id="how" class="mx-auto max-w-7xl px-4 py-24 sm:px-6">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-[11px] font-bold uppercase tracking-wider text-primary">Cómo funciona</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Tres pasos para profesionalizar tu club</h2>
  </div>

  <div class="mt-14 grid gap-6 md:grid-cols-3">
    {steps.map((s) => (
      <div class="relative rounded-3xl border border-border bg-card p-8 shadow-soft">
        <span class="text-5xl font-bold text-gradient">{s.n}</span>
        <h3 class="mt-3 text-xl font-semibold">{s.t}</h3>
        <p class="mt-2 text-sm text-muted-foreground">{s.d}</p>
      </div>
    ))}
  </div>
</section>
