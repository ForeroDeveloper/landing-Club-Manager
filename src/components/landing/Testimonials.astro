---
const items = [
  {
    q: "Pasamos del 62% al 97% de cobro mensual en 3 meses. Ya no perseguimos a los padres.",
    n: "Andrés Calle",
    r: "Director, Club Deportivo Atlas",
  },
  {
    q: "El módulo de horas y nómina nos ahorra 8 horas semanales. Los entrenadores cobran al día.",
    n: "Marcela Ríos",
    r: "Administradora, Academia Élite FC",
  },
  {
    q: "Por fin un dashboard que entiendo. Veo mi recaudo, asistencia y gastos en un solo lugar.",
    n: "Juan Pablo Mejía",
    r: "Presidente, Club Halcones",
  },
];
---

<section class="bg-background py-24 border-y border-border relative overflow-hidden">
  <!-- Subtle background grid -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 relative z-10">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-[11px] font-bold uppercase tracking-wider text-primary">Prueba Social</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Clubes que ya eliminaron el caos</h2>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {items.map((t) => (
        <figure class="relative rounded-3xl border border-white/5 bg-white/5 backdrop-blur-xl p-8 shadow-card hover:shadow-glow transition-all duration-300 group">
          <!-- Subtle glow on hover -->
          <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity rounded-3xl pointer-events-none"></div>
          
          <div class="flex gap-1 text-warning relative z-10">
            {Array.from({ length: 5 }).map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>
          <blockquote class="mt-6 text-base leading-relaxed text-foreground relative z-10">"{t.q}"</blockquote>
          <figcaption class="mt-8 flex items-center gap-4 relative z-10">
            <div class="grid h-12 w-12 place-items-center rounded-full bg-gradient-hero text-sm font-bold text-primary-foreground shadow-inner">
              {t.n.split(" ").map(p => p[0]).slice(0, 2).join("")}
            </div>
            <div>
              <p class="text-sm font-bold">{t.n}</p>
              <p class="text-xs text-muted-foreground">{t.r}</p>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
